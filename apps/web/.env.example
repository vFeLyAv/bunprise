# Copy to .env.local (git-ignored) and fill in the values from docs/setup.md.
# Only VITE_* variables reach the browser. Never put secret keys (service_role, SMTP, Turnstile secret) here.

# Supabase project URL, e.g. https://xxxx.supabase.co
VITE_SUPABASE_URL=
# Supabase publishable key (public; starts with sb_publishable_ or eyJ...)
VITE_SUPABASE_PUBLISHABLE_KEY=
# Enable real Google sign-in (1) after provider setup; the method stays visible when unavailable.
# Demo mode never simulates a successful social sign-in. Provider secrets belong only in Supabase.
VITE_GOOGLE_ENABLED=
# Enable real Apple web sign-in (1) after Apple + Supabase setup (docs/setup.md).
# Never add the Apple .p8 signing key or client secret to VITE_* variables.
VITE_APPLE_ENABLED=
# Cloudflare Turnstile site key (public; optional — empty = no captcha widget, no third-party script)
VITE_TURNSTILE_SITE_KEY=
# Public origin used to build invite links; defaults to window.location.origin when empty
VITE_APP_URL=
# The bring-along list "Mitbringen" on an occasion (1 = on; the demo always shows it). Only together with the
# pilot-3 legal texts and supabase/migrations/20261025150000_potluck.sql (docs/handoffs/2026-10-25-potluck.md).
VITE_POTLUCK=
# In-app invitations "Freunde einladen" (1 = on; the demo always shows them). On since the 4th release (Felix 26.10),
# only together with the pilot-4 legal texts and the database switch on (supabase/migrations/20261027130000_occasion_
# invitations_on.sql; docs/handoffs/2026-10-27-in-app-invites.md).
VITE_INVITES=
# The cover motif choice in the occasion form (1 = on; the demo always offers it): writes occasions.cover_theme, so
# only after supabase/migrations/20261027140000_occasion_cover_theme.sql is pushed (docs/handoffs/2026-10-27-occasion-covers.md).
VITE_COVERS=
# Web Push notifications "X lädt dich ein" (1 = show the settings row and the hint; the demo always shows them, without
# real pushes). Only after the Worker secrets (VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, PUSH_DISPATCH_SECRET), the Vault secret
# push_dispatch_secret, supabase/migrations/20261027150000_web_push.sql and the release switch (supabase/emergency/
# web_push_on.sql) together with the pilot-5 privacy text (docs/handoffs/2026-10-27-web-push.md).
VITE_PUSH=
# Kalender-Abo (1 = the row in Profil; the demo always shows it, with a simulated address). Only after
# supabase/migrations/20261027170000_calendar_feed.sql, the Worker vars CALENDAR_FEED=on + SUPABASE_PUBLISHABLE_KEY
# (workers/edge/wrangler.jsonc) and the pilot-5 privacy text (docs/handoffs/2026-10-27-calendar.md).
VITE_CALENDAR_FEED=
# The invitation e-mail (1 = the switch "Bei neuen Einladungen eine E-Mail schicken" in Profil › Privatsphäre; the demo always
# shows it, without real mails). Only after supabase/migrations/20261028000000_invite_email.sql, the Worker secret
# BREVO_API_KEY (Felix only: npx wrangler secret put BREVO_API_KEY), the release switch (supabase/emergency/invite_email_on.sql)
# and the pilot-6 privacy text (docs/handoffs/2026-10-27-invite-email.md).
VITE_INVITE_EMAIL=
# One wish in several lists (1 = "Aus meinen Listen holen" ADDS the wish to the occasion instead of moving it; the demo
# always does). Only after supabase/migrations/20261027200000_shared_wishes.sql is pushed; while the database switch
# (supabase/emergency/shared_wishes_on.sql) is off the app falls back to moving (docs/handoffs/2026-10-27-shared-wishes.md).
VITE_SHARED_WISHES=
